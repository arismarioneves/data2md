{
    "name": "data2md/data2md",
    "description": "Convert data files to Markdown format",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Data2Md\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Data2Md\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
