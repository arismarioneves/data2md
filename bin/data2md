#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Operator CLI. Runs inside the container:
 *
 *   docker compose exec app bin/data2md gc
 *   docker compose exec app bin/data2md logs --tail=50
 */

use Data2Md\Auth\ApiTokenStore;
use Data2Md\Auth\LoginTokenStore;
use Data2Md\Auth\SessionStore;
use Data2Md\Auth\UserStore;
use Data2Md\Billing\Entitlement;
use Data2Md\Billing\WebhookEventStore;
use Data2Md\Log\Logger;
use Data2Md\Storage\Database;
use Data2Md\Storage\FileStorage;
use Data2Md\Storage\Gc;
use Data2Md\Storage\MappingStorage;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

define('BASE_PATH', dirname(__DIR__));

/** @var \Data2Md\Config\Config $config */
$config = require BASE_PATH . '/src/bootstrap.php';

$dataDir = $config->string('APP_DATA_DIR');
$command = $argv[1] ?? 'help';

/** @param list<string> $argv */
function option(array $argv, string $name, string $default): string
{
    foreach ($argv as $arg) {
        if (str_starts_with($arg, "--$name=")) {
            return substr($arg, strlen($name) + 3);
        }
    }
    return $default;
}

/**
 * Migration belongs to `data2md migrate`, which the entrypoint runs. Read and
 * maintenance commands only report a missing schema.
 */
function requireSchema(Database $db): void
{
    if ($db->version() !== 0) {
        return;
    }

    fwrite(STDERR, "database has no schema yet — run: data2md migrate\n");
    exit(1);
}

/** Shared by gc, delete and prune, so the three can never drift apart. */
function makeGc(\Data2Md\Config\Config $config, string $dataDir): Gc
{
    $db = new Database($dataDir . '/db/mappings.sqlite');
    requireSchema($db);

    return new Gc(
        files:                     new FileStorage($dataDir . '/md', $dataDir . '/tmp'),
        mappings:                  new MappingStorage($db),
        logger:                    new Logger($dataDir . '/logs'),
        logDir:                    $dataDir . '/logs',
        rateLimitDir:              $dataDir . '/ratelimit',
        logRetentionDays:          $config->int('LOG_RETENTION_DAYS'),
        auditLogRetentionDays:     $config->int('AUDIT_LOG_RETENTION_DAYS'),
        rateLimitMaxWindowSeconds: \Data2Md\rate_limit_max_window_seconds($config),
        convertTimeoutSeconds:     $config->int('CONVERT_TIMEOUT_SECONDS'),
        lockDir:                   $dataDir . '/tmp',
        sessions:                  new SessionStore(
            $db,
            $config->int('SESSION_LIFETIME_DAYS'),
            $config->int('SESSION_IDLE_DAYS'),
        ),
        loginTokens:               new LoginTokenStore($db, $config->int('LOGIN_TOKEN_TTL_SECONDS')),
        webhookEvents:             new WebhookEventStore($db),
    );
}

switch ($command) {
    case 'config:check':
        // Reaching this line means bootstrap validated everything.
        fwrite(STDOUT, sprintf(
            "configuration OK (%d required, %d optional with defaults)\n",
            count(\Data2Md\Config\Config::requiredKeys()),
            count(\Data2Md\Config\Config::optionalKeys())
        ));
        exit(0);

    case 'migrate':
        $db     = new Database($dataDir . '/db/mappings.sqlite');
        $latest = Database::latestVersion();

        if (in_array('--status', $argv, true)) {
            $version = $db->version();

            fwrite(STDOUT, sprintf("database %d, build %d\n", $version, $latest));

            if ($version < $latest) {
                fwrite(STDOUT, "pending: " . implode(', ', array_filter(
                    Database::migrationVersions(),
                    static fn (int $v): bool => $v > $version
                )) . "\n");
                exit(1);
            }

            fwrite(STDOUT, $version > $latest
                ? "schema is ahead of this build (older image, or a rollback)\n"
                : "up to date\n");
            exit(0);
        }

        $applied = $db->migrate();
        $version = $db->version();

        // migrate() treats this as a no-op, so this is the only place an
        // operator hears about a rollback onto a newer volume.
        if ($version > $latest) {
            (new Logger($dataDir . '/logs'))->app(
                'schema.ahead',
                ['db' => $version, 'build' => $latest],
                'warning'
            );
            fwrite(STDOUT, "schema is ahead of this build (database $version, build $latest) — no changes made\n");
            exit(0);
        }

        fwrite(STDOUT, $applied === []
            ? "schema up to date (version $version)\n"
            : 'applied ' . implode(', ', $applied) . " — now at version $version\n");
        exit(0);

    case 'gc':
        $report = makeGc($config, $dataDir)->run();

        if ($report->skipped) {
            fwrite(STDOUT, "skipped: another collection is already in progress\n");
            exit(0);
        }

        foreach ($report->toArray() as $key => $count) {
            fwrite(STDOUT, sprintf("%-22s %d\n", $key, $count));
        }
        fwrite(STDOUT, sprintf("%-22s %d\n", 'total', $report->total()));
        exit(0);

    case 'delete':
        $hash = $argv[2] ?? '';

        if (preg_match('/^[a-f0-9]{15}$/', $hash) !== 1) {
            fwrite(STDERR, "usage: data2md delete <hash>\n");
            exit(1);
        }

        $removed = makeGc($config, $dataDir)->delete($hash);

        fwrite(STDOUT, $removed ? "deleted $hash\n" : "not found: $hash\n");
        exit($removed ? 0 : 1);

    case 'prune':
        $days = (int) option($argv, 'older-than', '0');

        if ($days < 1) {
            fwrite(STDERR, "usage: data2md prune --older-than=<days>\n");
            fwrite(STDERR, "this permanently removes conversions; there is no undo\n");
            exit(1);
        }

        $removed = makeGc($config, $dataDir)->prune($days);

        fwrite(STDOUT, "removed $removed conversion(s) older than $days day(s)\n");
        exit(0);

    case 'list':
        $limit = (int) option($argv, 'limit', '20');

        $db = new Database($dataDir . '/db/mappings.sqlite');
        requireSchema($db);

        $mappings = new MappingStorage($db);
        $files    = new FileStorage($dataDir . '/md', $dataDir . '/tmp');

        $rows  = $mappings->recent($limit);
        $total = $mappings->count();

        if ($rows === []) {
            fwrite(STDOUT, "no conversions stored\n");
            exit(0);
        }

        fwrite(STDOUT, sprintf("%-16s %10s %10s  %-16s %s\n", 'HASH', 'UPLOAD', 'MARKDOWN', 'CREATED', 'NAME'));

        foreach ($rows as $row) {
            fwrite(STDOUT, sprintf(
                "%-16s %10s %10s  %-16s %s\n",
                $row['hash'],
                \Data2Md\format_bytes($row['size_bytes']),
                $files->markdownExists($row['hash'])
                    ? \Data2Md\format_bytes($files->markdownSize($row['hash']))
                    : 'MISSING',
                gmdate('Y-m-d H:i', $row['created_at']),
                $row['original_name']
            ));
        }

        fwrite(STDOUT, sprintf("\nshowing %d of %d\n", count($rows), $total));
        exit(0);

    case 'logs':
        $channel = option($argv, 'channel', 'app');
        $tail    = (int) option($argv, 'tail', '50');

        if (!in_array($channel, Logger::CHANNELS, true)) {
            fwrite(STDERR, "unknown channel: $channel (use " . implode(', ', Logger::CHANNELS) . ")\n");
            exit(1);
        }

        $path = $dataDir . '/logs/' . $channel . '.jsonl';

        if (!is_file($path)) {
            fwrite(STDOUT, "no entries yet\n");
            exit(0);
        }

        $lines = [];
        $handle = fopen($path, 'rb');

        while (($line = fgets($handle)) !== false) {
            $lines[] = rtrim($line);

            if (count($lines) > $tail) {
                array_shift($lines);
            }
        }
        fclose($handle);

        foreach ($lines as $line) {
            $entry = json_decode($line, true);

            if (!is_array($entry)) {
                fwrite(STDOUT, $line . "\n");
                continue;
            }

            $ts   = $entry['ts']  ?? '?';
            $evt  = $entry['evt'] ?? $channel;
            unset($entry['ts'], $entry['evt'], $entry['lvl']);

            $rest = [];
            foreach ($entry as $key => $value) {
                $rest[] = $key . '=' . (is_scalar($value) ? (string) $value : json_encode($value));
            }

            fwrite(STDOUT, sprintf("%s  %-18s %s\n", $ts, $evt, implode(' ', $rest)));
        }
        exit(0);

    case 'user:premium':
        $email = $argv[2] ?? '';
        $days  = (int) option($argv, 'days', '-1');

        if ($email === '' || $days < 0) {
            fwrite(STDERR, "usage: data2md user:premium <email> --days=<n>   (0 revokes)\n");
            exit(1);
        }

        $db = new Database($dataDir . '/db/mappings.sqlite');
        requireSchema($db);

        $users = new UserStore($db);
        $user  = $users->findByEmail($email);

        if ($user === null) {
            fwrite(STDERR, "no such account: $email\n");
            exit(1);
        }

        // premium_until is the manual grant Entitlement honours ahead of any
        // subscription, which is what makes a courtesy account possible without
        // inventing a Stripe subscription for it.
        $until = $days === 0 ? null : time() + ($days * 86400);

        $users->setPremiumUntil((int) $user['id'], $until);

        fwrite(STDOUT, $until === null
            ? "revoked the premium grant for $email\n"
            : "$email is premium until " . gmdate('Y-m-d H:i', $until) . " UTC\n");
        exit(0);

    case 'token:create':
        $email = $argv[2] ?? '';

        if (filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
            fwrite(STDERR, "usage: data2md token:create <email>\n");
            exit(1);
        }

        $db = new Database($dataDir . '/db/mappings.sqlite');
        requireSchema($db);

        $users  = new UserStore($db);
        $known  = $users->findByEmail($email) !== null;
        $userId = $users->ensure($email);

        // Signing in is also signing up, so this stays true of the CLI: it is
        // how the first account on a deployment gets made.
        if (!$known) {
            fwrite(STDOUT, "created account $email\n");
        }

        $tokens   = new ApiTokenStore($db);
        $existing = $tokens->describeFor($userId);
        $raw      = $tokens->issue($userId);

        if ($existing !== null) {
            fwrite(STDOUT, sprintf(
                "replaced %s...%s — it stops working now\n",
                $existing['prefix'],
                $existing['last4']
            ));
        }

        fwrite(STDOUT, "$raw\n");
        fwrite(STDOUT, "shown once; it is stored hashed and cannot be read back\n");

        // A token on a free account authenticates and is then refused by plan,
        // which is confusing to discover from a 403.
        if (Entitlement::forUser($users->findById($userId)) !== Entitlement::PREMIUM) {
            fwrite(STDERR, "warning: $email has no subscription, so POST /api will answer 403\n");
        }
        exit(0);

    case 'token:revoke':
        $email = $argv[2] ?? '';

        if ($email === '') {
            fwrite(STDERR, "usage: data2md token:revoke <email>\n");
            exit(1);
        }

        $db = new Database($dataDir . '/db/mappings.sqlite');
        requireSchema($db);

        $user = (new UserStore($db))->findByEmail($email);

        if ($user === null) {
            fwrite(STDERR, "no such account: $email\n");
            exit(1);
        }

        $revoked = (new ApiTokenStore($db))->revokeFor((int) $user['id']);

        fwrite(STDOUT, $revoked ? "revoked the token for $email\n" : "$email has no token\n");
        exit($revoked ? 0 : 1);

    case 'health':
        $checks = require BASE_PATH . '/src/health-checks.php';

        $failed = 0;
        foreach ($checks as $name => $ok) {
            fwrite(STDOUT, sprintf("%-14s %s\n", $name, $ok ? 'ok' : 'FAIL'));
            $failed += $ok ? 0 : 1;
        }
        exit($failed === 0 ? 0 : 1);

    default:
        fwrite(STDOUT, <<<TXT
        data2md CLI

          config:check          validate every environment variable
          migrate [--status]    apply pending schema migrations; --status only reports
          list [--limit=N]      stored conversions, newest first
          gc                    housekeeping: orphans, rate limits, rotated logs
          delete <hash>         permanently remove one conversion
          prune --older-than=N  permanently remove conversions older than N days
          user:premium <email>  grant premium directly: --days=N, 0 revokes
          token:create <email>  issue or replace an account's API token
          token:revoke <email>  remove an account's API token
          logs [--channel=app|audit|mail] [--tail=N]
          health                run the same checks as GET /health

        Converted markdown is permanent. Only delete and prune remove it.

        TXT);
        exit($command === 'help' ? 0 : 1);
}
