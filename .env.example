# Referencia das variaveis do servico (EasyPanel, ou outro host). Para rodar
# localmente com docker compose, use um arquivo .env na raiz: ele sobrescreve
# estes valores e nao entra em commit nem no contexto de build.

# APP_URL deve ser definido explicitamente. Nao ha valor padrao generico e
# nao deve ser derivado do Host da requisicao.
APP_URL=http://localhost:8080

APP_ENV=production
APP_NAME=data2md
APP_VERSION=1.1.0
APP_DATA_DIR=/var/lib/data2md

MAX_FILE_SIZE_MB=200
CONVERT_TIMEOUT_SECONDS=900
CONVERT_CONCURRENCY=2
CONVERT_QUEUE_WAIT_SECONDS=20
CONVERT_NICE=15
PHP_MEMORY_LIMIT_MB=512

RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# Rede do EasyPanel/Traefik na VPS. Se estiver errada, todo o
# trafego conta como um unico IP e o rate limit deixa de funcionar.
TRUSTED_PROXIES=10.11.0.0/16

# Vazio desativa CORS por completo (o preflight passa a responder 405).
CORS_ALLOWED_ORIGINS=

LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=30
GC_PROBABILITY=0.01

# Canal de contato publicado nas paginas de Termos e Privacidade.
CONTACT_EMAIL=contato@data2md.com.br


# ─────────────────────────────────────────────────────────────────────────────
# Optional. Every key below has a default in code; the value shown is that
# default. Set only what you mean to change — a key left blank falls back to
# the default rather than failing boot.
# ─────────────────────────────────────────────────────────────────────────────

# Accounts and billing stay off until switched on. Turning ACCOUNTS_ENABLED on
# requires a way to send the sign-in link (SMTP_HOST, or MAIL_TRANSPORT=log for
# development). BILLING_ENABLED additionally requires accounts and all three
# STRIPE_* values.
#ACCOUNTS_ENABLED=false
#BILLING_ENABLED=false

# Conversion limits per caller. MAX_FILE_SIZE_MB above stays the ceiling Apache
# and PHP enforce at boot; these only tighten it, and none may exceed it.
#TIER_ANON_MAX_CONVERSIONS=1
#TIER_ANON_WINDOW_SECONDS=3600
#TIER_ANON_MAX_FILE_SIZE_MB=10
#TIER_FREE_MAX_CONVERSIONS=1
#TIER_FREE_WINDOW_SECONDS=600
#TIER_FREE_MAX_FILE_SIZE_MB=20
# Floor applied per address on top of the per-account limit, since accounts are
# free and self-serve. 0 disables it.
#TIER_FREE_IP_WINDOW_SECONDS=120
#TIER_PREMIUM_MAX_CONVERSIONS=1
#TIER_PREMIUM_WINDOW_SECONDS=30
#TIER_PREMIUM_MAX_FILE_SIZE_MB=200

# Sessions and sign-in links.
#SESSION_LIFETIME_DAYS=30
#SESSION_IDLE_DAYS=14
#LOGIN_TOKEN_TTL_SECONDS=900
#LOGIN_MAX_PER_EMAIL=3
#LOGIN_MAX_PER_IP=10
#LOGIN_WINDOW_SECONDS=900

# Outbound mail. With magic-link sign-in, deliverability is login availability:
# use a relay with SPF and DKIM for the domain. MAIL_TRANSPORT=log writes the
# link to a log instead of sending, for development and CI.
#MAIL_TRANSPORT=smtp
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_ENCRYPTION=tls
#SMTP_TIMEOUT_SECONDS=10
# Empty falls back to CONTACT_EMAIL.
#MAIL_FROM=

# Stripe. A test-mode key with APP_ENV=production is rejected, and so is a live
# key in development.
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_ID=

# Display mirrors of the Stripe price, for the pricing page only. Billing always
# uses the price object, so a mismatch here makes the page lie.
#PREMIUM_PRICE_USD=19
#PREMIUM_PRICE_BRL=95
